// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. MODUL AUTENTIKASI (AUTH)
// ==========================================

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth Relations
  accounts      Account[]
  sessions      Session[]

  // Business Modules Relations
  courses         Course[]
  semesters       Semester[]
  memberships     OrganizationMember[]
  orgEvents       OrganizationEvent[]
  orgTasks        OrganizationTask[]
  habits          Habit[]
  habitCategories HabitCategory[]
  goals           Goal[]
  goalReviews     GoalProgressReview[]
  transactions      Transaction[]
  budgets           Budget[]
  financialGoals    FinancialGoal[]
  financeCategories FinanceCategory[]
  notificationPreference NotificationPreference?
  debtsReceivables  DebtReceivable[]
  recurringBills    RecurringBill[]
  secondaryEmails   SecondaryEmail[]
  clients           Client[]
  projects          Project[]
  invoices          Invoice[]
  incomes           Income[]
  jobApplications   JobApplication[]
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// ==========================================
// 2. MODUL AKADEMIK (ACADEMIC)
// ==========================================

model Course {
  id         String   @id @default(uuid())
  userId     String
  semesterId String?
  name       String
  code       String?
  lecturer   String?
  day        String
  startTime  String   // Format "HH:MM"
  endTime    String   // Format "HH:MM"
  room       String?
  credits    Int      @default(2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester    Semester?    @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  assignments Assignment[]
  exams       Exam[]
}

model Assignment {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  dueDate     DateTime
  status      String   @default("TODO")     // "TODO", "IN_PROGRESS", "DONE"
  priority    String   @default("MEDIUM")   // "LOW", "MEDIUM", "HIGH"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Exam {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  date      DateTime
  room      String?
  type      String   @default("CLOSED_BOOK") // "OPEN_BOOK", "CLOSED_BOOK", "TAKE_HOME"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Semester {
  id        String   @id @default(uuid())
  userId    String
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]
}

// ==========================================
// 3. MODUL ORGANISASI (ORGANIZATION)
// ==========================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  description String?
  period      String?  // e.g., "2025–2026"
  logoIcon    String   @default("🏢")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members OrganizationMember[]
  events  OrganizationEvent[]
}

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           String   @default("MEMBER") // "CHAIR", "SECRETARY", "TREASURER", "MEMBER"
  position       String?  // Jabatan spesifik, e.g. "Staff IT", "Koordinator Media"
  period         String?  // e.g., "2025–2026"
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model OrganizationEvent {
  id             String   @id @default(uuid())
  organizationId String
  userId         String   // creator / owner
  title          String
  description    String?
  type           String   @default("OTHER") // "MEETING", "EVENT", "SEMINAR", "PROKER", "OTHER"
  date           DateTime
  endDate        DateTime?
  location       String?
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks        OrganizationTask[]
}

model OrganizationTask {
  id               String    @id @default(uuid())
  eventId          String?
  userId           String    // owner: the logged-in user who created/tracks this task
  title            String
  description      String?
  dueDate          DateTime?
  priority         String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH"
  status           String    @default("TODO")   // "TODO", "IN_PROGRESS", "DONE"
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  event  OrganizationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 4. MODUL HABIT TRACKER
// ==========================================

model Habit {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  categoryId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category HabitCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  logs     HabitLog[]
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  date      DateTime @db.Date
  completed Boolean  @default(false)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model HabitCategory {
  id        String   @id @default(uuid())
  userId    String
  name      String
  icon      String   @default("📌")
  color     String   @default("bg-muted")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits Habit[]

  @@unique([userId, name])
}

model Goal {
  id          String               @id @default(uuid())
  userId      String
  title       String               // "IPK 3.75", "Menjadi Ketua Divisi IT"
  description String?
  category    String               // "ACADEMIC", "ORGANIZATION", "HABIT", "PERSONAL", "CAREER"
  status      String               @default("ACTIVE") // "ACTIVE", "ACHIEVED", "PAUSED", "DROPPED"
  progress    Int                  @default(0) // 0–100
  targetDate  DateTime?
  emoji       String               @default("🎯")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones  GoalMilestone[]
  reviews     GoalProgressReview[]
  financialGoals FinancialGoal[]
}

model GoalMilestone {
  id          String   @id @default(uuid())
  goalId      String
  title       String   // "Selesaikan Semester 5", "Submit Proposal TA"
  isCompleted Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model GoalProgressReview {
  id        String   @id @default(uuid())
  goalId    String
  userId    String
  month     Int      // 1–12
  year      Int
  progress  Int      // snapshot progress bulan ini
  note      String?  // catatan refleksi
  createdAt DateTime @default(now())

  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinanceCategory {
  id        String   @id @default(uuid())
  userId    String
  name      String
  icon      String   @default("💰")
  color     String   @default("bg-muted text-muted-foreground border-border/30")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String
  type          String   // "INCOME", "EXPENSE"
  amount        Float
  categoryId    String
  projectId     String?  // Optional relation to Career Project
  paymentMethod String   @default("TUNAI") // "TUNAI" or "NON_TUNAI"
  date          DateTime @default(now())
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  project  Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  amount     Float    // Limit batas pengeluaran
  month      Int      // 1–12
  year      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
}

model FinancialGoal {
  id            String    @id @default(uuid())
  userId        String
  title         String    // "Beli Laptop Baru", "Biaya Wisuda"
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  emoji         String    @default("💰")
  goalId        String?   // Opsional: Hubungan ke Life Goal
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal         Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
}

model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  deadlineTugas       Boolean  @default(true)
  habitReminder       Boolean  @default(true)
  agendaOrganisasi    Boolean  @default(true)
  budgetWarning       Boolean  @default(true)
  weeklyReview        Boolean  @default(true)
  dailyFinanceReport  Boolean  @default(false)
  monthlyReport       Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DebtReceivable {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "DEBT" (Hutang), "RECEIVABLE" (Piutang)
  contact   String   // nama kontak
  amount    Float
  purpose   String
  dueDate   DateTime
  status    String   @default("PENDING") // "PENDING", "PAID"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecurringBill {
  id        String   @id @default(uuid())
  userId    String
  name      String
  amount    Float
  dueDay    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecondaryEmail {
  id                  String   @id @default(uuid())
  userId              String
  email               String
  label               String   // "Orang Tua", "Pasangan", dll.
  deadlineTugas       Boolean  @default(false)
  habitReminder       Boolean  @default(false)
  agendaOrganisasi    Boolean  @default(false)
  budgetWarning       Boolean  @default(false)
  weeklyReview        Boolean  @default(false)
  dailyFinanceReport  Boolean  @default(false)
  monthlyReport       Boolean  @default(false)
  transactionEmail    Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id        String    @id @default(uuid())
  userId    String
  name      String
  company   String
  email     String
  phone     String
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]
}

model Project {
  id              String        @id @default(uuid())
  userId          String
  clientId        String
  name            String
  description     String?       @db.Text
  contractValue   Float
  startDate       DateTime
  endDate         DateTime
  status          String        @default("PLANNING") // "PLANNING", "PROGRESS", "WAITING_FEEDBACK", "REVISION", "COMPLETED", "CANCELLED"
  financialGoalId String?       // Opsional: Hubungan untuk auto-update saving goal
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks        ProjectTask[]
  invoices     Invoice[]
  transactions Transaction[]
}

model ProjectTask {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  description String?  @db.Text
  dueDate     DateTime
  priority    String   @default("MEDIUM") // "LOW", "MEDIUM", "HIGH"
  status      String   @default("TODO")   // "TODO", "IN_PROGRESS", "DONE"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String   @id @default(uuid())
  userId        String
  projectId     String
  clientId      String
  invoiceNumber String   @unique // e.g. "INV-2026-001"
  amount        Float
  issuedDate    DateTime
  dueDate       DateTime
  status        String   @default("DRAFT") // "DRAFT", "SENT", "PAID", "OVERDUE"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  incomeRecord Income?
}

model Income {
  id        String   @id @default(uuid())
  userId    String
  invoiceId String?  @unique // Terisi jika terkonversi dari invoice PAID
  source    String   // "FREELANCE", "PART_TIME", "MAGANG", "BONUS"
  amount    Float
  date      DateTime
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

model JobApplication {
  id          String   @id @default(uuid())
  userId      String
  companyName String
  position    String
  jobLink     String?
  appliedDate DateTime
  status      String   @default("WISHLIST") // "WISHLIST", "APPLIED", "HR_INTERVIEW", "TECHNICAL_TEST", "USER_INTERVIEW", "OFFERING", "ACCEPTED", "REJECTED"
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}




